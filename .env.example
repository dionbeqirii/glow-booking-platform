# ---- Supabase (PostgreSQL) ----
# Nga Supabase: Project Settings → Database → Connection string.
# DATABASE_URL përdor "Connection pooling" (porti 6543, me ?pgbouncer=true) — për aplikacionin.
# DIRECT_URL përdor lidhjen direkte (porti 5432) — për migrimet e Prisma.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ---- Auth ----
# Sekret për nënshkrimin e JWT-ve (gjenero një varg të rastësishëm të gjatë).
JWT_SECRET="ndrysho-kete-me-nje-sekret-te-gjate-dhe-te-rastesishem"
