// Prisma schema — Glow By Diellza (skincare studio)
// Reservation & Queue Management Platform — maps 1:1 to the thesis ER diagram.
// Database: Supabase (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------
enum Role {
  ADMIN
  STAFF
  CLIENT
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  NO_SHOW
}

enum NotificationType {
  CONFIRMATION
  REMINDER
  STATUS_CHANGE
  QUEUE_CALL
}

// ---------- Core entities ----------
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())

  // staff-side relations
  staffServices  StaffService[]
  workingHours   WorkingHours[]
  timeOff        TimeOff[]
  bookingsAsStaff  Booking[]     @relation("StaffBookings")
  queueAsStaff     QueueEntry[]  @relation("StaffQueue")

  // client-side relations
  bookingsAsClient Booking[]     @relation("ClientBookings")
  queueAsClient    QueueEntry[]  @relation("ClientQueue")

  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([role])
}

model Service {
  id           String   @id @default(cuid())
  name         String
  description  String?
  durationMin  Int
  price        Decimal  @default(0) @db.Decimal(10, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  staffServices StaffService[]
  bookings      Booking[]
  queueEntries  QueueEntry[]
}

// Which services each staff member can perform (skills)
model StaffService {
  staffId   String
  serviceId String
  staff     User    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model WorkingHours {
  id        String @id @default(cuid())
  staffId   String
  weekday   Int    // 0 = Sunday ... 6 = Saturday
  startTime String // "09:00"
  endTime   String // "17:00"
  staff     User   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model TimeOff {
  id      String   @id @default(cuid())
  staffId String
  from    DateTime
  until   DateTime
  reason  String?
  staff   User     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model Booking {
  id        String        @id @default(cuid())
  clientId  String
  serviceId String
  staffId   String
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())

  client  User    @relation("ClientBookings", fields: [clientId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  staff   User    @relation("StaffBookings", fields: [staffId], references: [id])

  // Fast lookup + first line of defense against overlaps for the same staff.
  @@index([staffId, startTime])
  @@index([clientId])
}

model QueueEntry {
  id                String      @id @default(cuid())
  clientId          String?     // nullable: walk-in without an account
  clientName        String?     // used for walk-ins without an account
  serviceId         String
  staffId           String?     // assigned later
  queueNumber       Int
  checkinAt         DateTime    @default(now())
  estimatedWaitMin  Int         @default(0)
  status            QueueStatus @default(WAITING)
  calledAt          DateTime?
  // Set when the administrator pins a staff member manually (FR-12); the
  // auto-refresh then stops re-suggesting a different one for this entry.
  staffLocked       Boolean     @default(false)

  client  User?   @relation("ClientQueue", fields: [clientId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  staff   User?   @relation("StaffQueue", fields: [staffId], references: [id])

  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}
