// Prisma schema — Glow By Diellza (skincare studio)
// Reservation & Queue Management Platform — maps 1:1 to the thesis ER diagram.
// Database: Supabase (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------
enum Role {
  ADMIN
  STAFF
  CLIENT
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Admin-tracked "did the client pay" flag — not a payment gateway integration,
// just a status the studio toggles manually against cash/in-person payment.
enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  NO_SHOW
}

enum NotificationType {
  CONFIRMATION
  REMINDER
  STATUS_CHANGE
  QUEUE_CALL
}

// ---------- Core entities ----------
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  avatarUrl    String?
  title        String?  // staff-only: job title/specialization (e.g. "Terapiste e Lëkurës")
  passwordHash String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  loyaltyPoints Int     @default(0) // client-only: earned on completed visits, 1 point per €1 spent

  // staff-side relations
  staffServices  StaffService[]
  workingHours   WorkingHours[]
  timeOff        TimeOff[]
  bookingsAsStaff  Booking[]     @relation("StaffBookings")
  queueAsStaff     QueueEntry[]  @relation("StaffQueue")

  // client-side relations
  bookingsAsClient Booking[]     @relation("ClientBookings")
  queueAsClient    QueueEntry[]  @relation("ClientQueue")
  feedbackGiven    Feedback[]
  waitlistEntries       Waitlist[]     @relation("WaitlistClient")
  waitlistStaffPref     Waitlist[]     @relation("WaitlistStaffPref")
  priorityHoldsAsClient PriorityHold[] @relation("PriorityHoldClient")
  priorityHoldsAsStaff  PriorityHold[] @relation("PriorityHoldStaff")

  notifications Notification[]
  auditLogs     AuditLog[]
  passwordResets PasswordResetToken[]
  dashboardLayout DashboardLayout?

  @@index([role])
}

model Service {
  id           String   @id @default(cuid())
  name         String
  description  String?
  category     String?
  imageUrl     String?
  durationMin  Int
  price        Decimal  @default(0) @db.Decimal(10, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  staffServices StaffService[]
  bookings      Booking[]
  queueEntries  QueueEntry[]
  offerBundles  OfferService[]
  queueVisits   QueueEntryService[]
  waitlist      Waitlist[]
}

// A client waiting for a slot to free up for a service (3.3), optionally
// narrowed to one staff member. FIFO by createdAt: the earliest entry that
// matches a newly-cancelled booking's service (and staff, if they specified
// one) gets first priority.
model Waitlist {
  id        String   @id @default(cuid())
  clientId  String
  serviceId String
  staffId   String?
  createdAt DateTime @default(now())

  client  User    @relation("WaitlistClient", fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff   User?   @relation("WaitlistStaffPref", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([clientId, serviceId])
  @@index([serviceId, createdAt])
}

// A temporary exclusive claim on a just-freed slot (3.3): for
// `expiresAt`, only `clientId` may book [staffId, startTime, endTime) —
// everyone else is blocked until it lapses, at which point the slot is
// open to anyone (no cleanup needed; expiry is checked at read time).
model PriorityHold {
  id        String   @id @default(cuid())
  staffId   String
  startTime DateTime
  endTime   DateTime
  clientId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  staff  User @relation("PriorityHoldStaff", fields: [staffId], references: [id], onDelete: Cascade)
  client User @relation("PriorityHoldClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([staffId, startTime, endTime])
}

// A promoted deal bundling one or more existing services (its own title,
// photo, price and validity window) — booking an offer reuses the normal
// service booking flow, so availability/staff-matching logic is never
// duplicated. `validFrom`/`validUntil` are optional: an offer with neither
// runs indefinitely until the admin deactivates it.
model Offer {
  id          String    @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  price       Decimal   @db.Decimal(10, 2)
  durationMin Int       @default(60)
  validFrom   DateTime?
  validUntil  DateTime?
  active      Boolean   @default(true)
  services    OfferService[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active])
}

// Which services are bundled into one offer (many-to-many) — mirrors
// QueueEntryService's join-table shape.
model OfferService {
  id        String @id @default(cuid())
  offerId   String
  serviceId String

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([offerId, serviceId])
}

// Which services each staff member can perform (skills)
model StaffService {
  staffId   String
  serviceId String
  staff     User    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model WorkingHours {
  id        String @id @default(cuid())
  staffId   String
  weekday   Int    // 0 = Sunday ... 6 = Saturday
  startTime String // "09:00"
  endTime   String // "17:00"
  staff     User   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model TimeOff {
  id      String   @id @default(cuid())
  staffId String
  from    DateTime
  until   DateTime
  reason  String?
  staff   User     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model Booking {
  id        String        @id @default(cuid())
  clientId  String
  serviceId String
  staffId   String
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(CONFIRMED)
  paymentStatus PaymentStatus @default(UNPAID)
  createdAt DateTime      @default(now())

  client  User    @relation("ClientBookings", fields: [clientId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  staff   User    @relation("StaffBookings", fields: [staffId], references: [id])
  feedback Feedback?

  // Fast lookup + first line of defense against overlaps for the same staff.
  @@index([staffId, startTime])
  @@index([clientId])
}

// A client's rating + comment on a finished booking (2.6). Low ratings double
// as the studio's complaint channel — there is no separate ticket system, so
// the comment field carries that weight and the admin view flags them.
model Feedback {
  id        String   @id @default(cuid())
  bookingId String   @unique
  clientId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client  User    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model QueueEntry {
  id                String      @id @default(cuid())
  clientId          String?     // nullable: walk-in without an account
  clientName        String?     // used for walk-ins without an account
  phone             String?     // used for walk-ins without an account
  notes             String?     // front-desk note (allergies, preferences, etc.)
  serviceId         String
  staffId           String?     // assigned later
  queueNumber       Int
  checkinAt         DateTime    @default(now())
  estimatedWaitMin  Int         @default(0)
  status            QueueStatus @default(WAITING)
  calledAt          DateTime?
  // Visit lifecycle timestamps (3.1): when service actually began and ended,
  // distinct from calledAt (when the client was summoned).
  startedAt         DateTime?
  completedAt       DateTime?
  // Set when the administrator pins a staff member manually (FR-12); the
  // auto-refresh then stops re-suggesting a different one for this entry.
  staffLocked       Boolean     @default(false)

  client  User?   @relation("ClientQueue", fields: [clientId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  staff   User?   @relation("StaffQueue", fields: [staffId], references: [id])

  // Services actually performed during the visit (staff checks these off
  // before completing) — may include upsells beyond the one checked in for.
  visitServices QueueEntryService[]

  @@index([status])
}

// Which services were actually rendered during one walk-in visit. Checked
// off by staff between "Fillo Vizitën" and "Përfundo"; feeds the invoice.
model QueueEntryService {
  id           String @id @default(cuid())
  queueEntryId String
  serviceId    String

  queueEntry QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([queueEntryId, serviceId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  deleted   Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, deleted])
}

// Password reset (self-service). Only the SHA-256 hash of the token is stored,
// so a database leak never exposes a usable reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Business/company profile — a single configurable row (FR-03/NFR-03), edited
// by the administrator and stored in the database.
model BusinessSettings {
  id          String   @id @default("business")
  name        String   @default("Glow By Diellza")
  address     String?
  phone       String?
  email       String?
  description String?
  updatedAt   DateTime @updatedAt
}

// Per-admin dashboard customization: which widgets are shown and in what
// order. `layout` is an ordered JSON array of {id, hidden}; missing/unknown
// entries are reconciled against the widget registry at read time, so
// adding a new widget later doesn't require a migration.
model DashboardLayout {
  userId    String   @id
  layout    Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String? // best-effort, from the request's x-forwarded-for/x-real-ip; null when neither header is present (e.g. local dev with no proxy)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}
